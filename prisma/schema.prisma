// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth Models ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(MEMBER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  projectMembers   ProjectMember[]
  assignedTasks    Task[]          @relation("TaskAssignee")
  createdTasks     Task[]          @relation("TaskCreator")
  comments         Comment[]
  activities       Activity[]
  createdProjects  Project[]       @relation("ProjectCreator")
  resourceAllocations ResourceAllocation[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Core Models ─────────────────────────────────────────────────────────────

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  priority    Priority      @default(MEDIUM)
  startDate   DateTime?
  dueDate     DateTime?
  color       String        @default("#B4ABF4")
  creatorId   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  creator    User            @relation("ProjectCreator", fields: [creatorId], references: [id])
  members    ProjectMember[]
  tasks      Task[]
  milestones Milestone[]
  activities Activity[]
  risks      Risk[]
  issues     Issue[]
  files      ProjectFile[]
  budget     Budget?
  resources  ResourceAllocation[]

  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      MemberRole  @default(MEMBER)
  joinedAt  DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(BACKLOG)
  priority    Priority   @default(MEDIUM)
  projectId   String?
  assigneeId  String?
  creatorId   String
  dueDate     DateTime?
  completedAt DateTime?
  position    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project    Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee   User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator    User       @relation("TaskCreator", fields: [creatorId], references: [id])
  comments   Comment[]
  labels     TaskLabel[]
  activities Activity[]

  @@index([status])
  @@index([priority])
  @@index([projectId])
  @@index([assigneeId])
  @@index([dueDate])
  @@map("tasks")
}

model Label {
  id    String      @id @default(cuid())
  name  String
  color String      @default("#B4ABF4")

  tasks TaskLabel[]

  @@map("labels")
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@map("task_labels")
}

model Milestone {
  id          String          @id @default(cuid())
  title       String
  description String?
  status      MilestoneStatus @default(PENDING)
  projectId   String
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("milestones")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  taskId    String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId])
  @@map("comments")
}

model Activity {
  id          String   @id @default(cuid())
  action      String
  description String
  userId      String
  projectId   String?
  taskId      String?
  createdAt   DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([userId])
  @@map("activities")
}

model Risk {
  id          String     @id @default(cuid())
  title       String
  description String?
  severity    RiskLevel  @default(MEDIUM)
  probability RiskLevel  @default(MEDIUM)
  status      RiskStatus @default(OPEN)
  projectId   String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("risks")
}

model Issue {
  id          String      @id @default(cuid())
  title       String
  description String?
  severity    RiskLevel   @default(MEDIUM)
  status      IssueStatus @default(OPEN)
  projectId   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("issues")
}

model ProjectFile {
  id        String   @id @default(cuid())
  name      String
  url       String
  size      Int?
  mimeType  String?
  projectId String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_files")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MEMBER
  VIEWER
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  MISSED
}

enum RiskLevel {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum RiskStatus {
  OPEN
  MITIGATED
  CLOSED
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ─── Finance & Invoice ────────────────────────────────────────────────────────

model Budget {
  id          String   @id @default(cuid())
  projectId   String   @unique
  totalAmount Float    @default(0)
  currency    String   @default("USD")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  expenses    Expense[]
  invoices    Invoice[]

  @@map("budgets")
}

model Expense {
  id          String          @id @default(cuid())
  budgetId    String
  title       String
  amount      Float
  category    ExpenseCategory @default(OTHER)
  date        DateTime        @default(now())
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
  @@map("expenses")
}

model Invoice {
  id          String        @id @default(cuid())
  budgetId    String
  invoiceNo   String        @unique
  title       String
  amount      Float
  status      InvoiceStatus @default(DRAFT)
  issuedAt    DateTime      @default(now())
  dueAt       DateTime?
  paidAt      DateTime?
  notes       String?
  image       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  budget  Budget        @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  items   InvoiceItem[]

  @@index([budgetId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float   @default(1)
  unitPrice   Float
  total       Float

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

// ─── Resource ─────────────────────────────────────────────────────────────────

model ResourceAllocation {
  id         String   @id @default(cuid())
  userId     String
  projectId  String
  role       String?
  hoursPerWeek Float  @default(0)
  startDate  DateTime?
  endDate    DateTime?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
  @@map("resource_allocations")
}

// ─── New Enums ────────────────────────────────────────────────────────────────

enum ExpenseCategory {
  LABOR
  SOFTWARE
  HARDWARE
  TRAVEL
  MARKETING
  OPERATIONS
  OTHER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}
