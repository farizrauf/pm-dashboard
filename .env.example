# ── Database ─────────────────────────────────────────────────────────────────
# Neon, Supabase, Prisma Postgres, atau PostgreSQL lainnya
DATABASE_URL="postgresql://user:password@host:5432/pm_dashboard?sslmode=require"

# ── Auth.js (NextAuth v5) ─────────────────────────────────────────────────────
# Generate dengan: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ── Untuk Vercel Production ───────────────────────────────────────────────────
# Set NEXTAUTH_URL ke URL production Anda:
# NEXTAUTH_URL="https://pm-dashboard.vercel.app"
