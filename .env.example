# Database - use Neon, Supabase, or Prisma Postgres
DATABASE_URL="postgresql://user:password@host:5432/pm_dashboard?sslmode=require"

# Auth.js - generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"

# OAuth providers (optional)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# App URL
NEXTAUTH_URL="http://localhost:3000"
